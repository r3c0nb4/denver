#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <sys/mman.h>
#include <string.h>
#include "utils.h"
#define STRIDE 4096
#define ITER 4096

#define NOPS(n) \
    asm volatile( \
        ".rept %0\n" \
        "nop\n" \
        ".endr\n" \
        :: "i" (n) \
    )

#define MOV(n)	\
	asm volatile(	\
		".rept %0\n" \
		"mov x10, x10\n" \
		".endr\n"	\
		::"i" (n): "x10" \
	)

#define REPEAT_10(x) x x x x x x x x x x 
#define STRIDE 4096
#define RELOAD_BUF_SIZE STRIDE * 256

unsigned char *reloadbuffer;
volatile unsigned char pick = 0;
uint64_t latency;
int idx;
int main(){
	reloadbuffer = (unsigned char *)mmap(0, RELOAD_BUF_SIZE, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_POPULATE | MAP_HUGETLB, -1, 0);
	memset(reloadbuffer, 1, sizeof(uint8_t) * RELOAD_BUF_SIZE);
	uint8_t data0 __attribute__((aligned(4096))) = 0;
	register uint8_t cycle = 0;
	
	cacheflush(&data0);
	for(int j = 0; j < 256; j++){
		cacheflush(&reloadbuffer[STRIDE * j]);
	}		
	for(volatile int z = 0; z < 100; z++){}
	barrier();
	pick = data0;
	NOPS(30);
	cycle = get_cycles() & 0XFF;
	pick = reloadbuffer[cycle << 12];

	for(int i = 0; i < 256; i++){
		idx = ((i * 167) + 13) & 255;	
		latency = cycles_read(&reloadbuffer[idx * STRIDE]);
		if(latency < 150){
			printf("%d\n", idx);
		}
	}
	printf("Architectural execution result: %u\n\n", cycle);
    return 0;
}
